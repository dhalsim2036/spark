generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Deliberately minimal persistence: no profile, location, request, or chat-message tables.
model Session {
  id        String   @id
  createdAt DateTime @default(now())
  lastSeen  DateTime
  expiresAt DateTime
}
model Report {
  id                String   @id @default(uuid())
  reporterSessionId String
  reportedSessionId String
  reason            String
  createdAt         DateTime @default(now())
  @@index([reportedSessionId, createdAt])
}
